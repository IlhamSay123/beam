<Window x:Class="Beam.App.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Beam" Height="390" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#141618">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="BeamTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Pair phone" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,24"/>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" Padding="10" VerticalAlignment="Top"><Image x:Name="QrImage" Width="200" Height="200"/></Border>
            <StackPanel Grid.Column="2">
                <TextBlock Text="LOCAL ADDRESS" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBlock x:Name="HostText" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <TextBlock Text="PAIRING TOKEN" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBox x:Name="TokenText" IsReadOnly="True" TextWrapping="Wrap" FontSize="13"/>
                <Button Click="CopyToken_Click" Margin="0,10,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Copy token"/></StackPanel></Button>
                <Button Click="CopyLink_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Copy pairing link"/></StackPanel></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
